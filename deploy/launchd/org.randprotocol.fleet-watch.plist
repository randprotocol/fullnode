<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The fleet watcher (deep scan 2026-09-24, "no monitoring"): every five minutes, every
         validator's health, height, view, build and free disk; a macOS notification and a line
         in the log on a stall, a node behind or unreachable, disk_low, or mixed builds.
         It runs a COPY of deploy/fleet-watch.sh (and the deploy/nodes.env it reads) under
         ~/rand-node-a/deploy/, not the shared checkout (ops review OPS-5).
         Install or refresh: deploy/install-launchd.sh fleet-watch -->
    <key>Label</key>
    <string>org.randprotocol.fleet-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/dendisuhubdy/rand-node-a/deploy/fleet-watch.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/dendisuhubdy/rand-node-a/fleet-watch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dendisuhubdy/rand-node-a/fleet-watch.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/dendisuhubdy</string>
    </dict>
</dict>
</plist>
