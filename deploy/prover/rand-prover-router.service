# The router of the prover.randprotocol.org pool (deploy/prover/router.py), on the web droplet.
# nginx terminates TLS and meters clients; this routes each job to a prover with a free slot.
[Unit]
Description=Rand prover pool router (prover.randprotocol.org)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=/etc/rand-prover-pool/router.env
ExecStart=/usr/bin/python3 /opt/rand-prover-pool/router.py
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=200M
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
